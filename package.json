{
  "name": "@xyb-community/liver-cancer-workbench",
  "version": "0.3.1",
  "description": "面向肝细胞癌（HCC）患者与照护者的本机优先工作台：肝功能储备与肿瘤负荷双轨记录、转化治疗评估、门脉高压与肝相关安全性、HBV 家庭防护",
  "private": true,
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh",
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check dsh/index.js && node --check lib/client.js && node scripts/check-workbench-package.mjs .",
    "pack:check": "npm pack --dry-run",
    "build:demo": "node --disable-warning=ExperimentalWarning demo/build-demo-data.mjs",
    "fetch:trials": "node --disable-warning=ExperimentalWarning scripts/fetch-hcc-trials-2026.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.mjs",
    "check:all": "npm run check && npm run test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyb-openharness-dsh-plugins/liver-cancer-workbench"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1 <4"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "UNLICENSED"
}
